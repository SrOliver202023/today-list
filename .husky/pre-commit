# Check if there are staged files
if [ -z "$(git diff --cached --name-only)" ]; then
  echo "ℹ️  No staged files to check. Skipping pre-commit hooks."
  exit 0
fi

echo "🔎 Running lint on staged files..."
npx lint-staged

STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo ""
  echo "❌ Lint failed! Please fix the errors before committing."
  echo "💡 You can skip this hook with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "✅ Lint passed! Continuing with commit..."
echo ""

echo "🏗️  Building project before commit..."
npm run build

STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo ""
  echo "❌ Build failed! Please fix the errors before committing."
  echo "💡 You can skip this hook with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "✅ Build passed! Proceeding with commit..."
