# Skip commitlint if commit was made via Commitizen
if [ -f .git/commitizen-flag ]; then
  echo "🔵 Commit made via Commitizen, skipping commitlint."
  exit 0
fi

# Validate commit message
OUTPUT=$(npx --no-install commitlint --edit "$1" 2>&1)
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "❌ Commit message validation failed!"
  echo ""
  echo "$OUTPUT"
  echo ""
  echo "💡 Example: git commit -m 'feat(login): add Google authentication'"
  echo "💡 Or use: npm run commit (for interactive commit)"
  echo ""
  exit 1
fi